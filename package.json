{
  "name": "@open-dcp/styles",
  "version": "0.1.28",
  "main": "dist/index.css",
  "style": "dist/index.css",
  "exports": {
    ".": {
      "import": "./dist/index.css",
      "default": "./dist/index.css"
    },
    "./scss": {
      "import": "./src/index.scss",
      "default": "./src/index.scss"
    },
    "./scss/variables": {
      "import": "./src/abstracts/_variables.scss",
      "default": "./src/abstracts/_variables.scss"
    },
    "./src/abstracts/variables": {
      "import": "./src/abstracts/_variables.scss",
      "default": "./src/abstracts/_variables.scss"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "start": "npm run dev",
    "dev": "sass --watch --no-source-map src/index.scss dist/index.css",
    "build": "sass --no-source-map src/index.scss dist/index.css"
  },
  "peerDependencies": {
    "sass": "^1.83.0"
  },
  "peerDependenciesMeta": {
    "sass": {
      "optional": true
    }
  },
  "devDependencies": {
    "sass": "^1.83.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Roche/dcp-pkg-fe-scss-styles.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
